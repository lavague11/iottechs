# Bug-runner config — copy to `.env` (gitignored) IN THE AUTOMATION CLONE and fill in.
# The real .env and token NEVER live in the primary workspace or in git.

# Production app that holds the queue DB + screenshots.
QUEUE_BASE_URL=https://iot-techs.com

# Bearer token — must EQUAL app_secrets.BUG_QUEUE_TOKEN (set it in /dev ▸ API Keys).
QUEUE_TOKEN=

# The DEDICATED automation clone — NOT your primary workspace.
AUTOMATION_BASE=C:\Users\La Vague\Desktop\iottechs-bug-runner

# Optional belt-and-suspenders: your primary workspace path, so the runner hard-refuses if they match.
PRIMARY_WORKSPACE=C:\Users\La Vague\Desktop\IOT APP

# Claude Code CLI binary (default: claude).
CLAUDE_BIN=claude

# Timings (ms).
POLL_MS=12000
CLAUDE_TIMEOUT_MS=1500000
TEST_TIMEOUT_MS=360000
BUILD_TIMEOUT_MS=720000
